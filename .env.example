# ---- Application ----
CT_ENVIRONMENT=local
CT_LOG_LEVEL=INFO

# ---- Database ----
# Local default is SQLite; docker-compose overrides this with PostgreSQL.
CT_DATABASE_URL=sqlite:///./credittrace.db
# CT_DATABASE_URL=postgresql+psycopg://credittrace:credittrace@db:5432/credittrace

# ---- Model registry ----
CT_MODEL_DIR=ml/artifacts
# Pin the service to a specific trained version; empty = latest available.
CT_MODEL_VERSION=

# ---- Decision anchoring (EVM) ----
# When false, decisions are scored and stored but NOT anchored on-chain
# (useful for unit tests and offline demos).
CT_CHAIN_ENABLED=true
CT_CHAIN_RPC_URL=http://anvil:8545
CT_CONTRACT_ADDRESS=
# Anvil's first well-known development key. NEVER use on a public network.
CT_CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Risk policy (probability-of-default thresholds, basis points) ----
CT_BAND_LOW_MAX_BPS=1500
CT_BAND_MEDIUM_MAX_BPS=4000
